# Hanya dibaca lewat ./docker/eoffice-compose.sh secara eksplisit.
# Jangan salin production.env. Jangan commit file docker/compose.env.
EOFFICE_BASE_URL=https://staging.example.invalid
EOFFICE_DEVICE_TOKEN=replace-with-authorized-staging-device-token
EOFFICE_HOST_MODEL_DIR=/absolute/path/outside-project/eoffice-models
EOFFICE_HOST_KEY_FILE=/absolute/path/outside-project/eoffice-secrets/eoffice-key.json
# Opsional jika 5000 sedang digunakan:
CAMERA_HOST_PORT=5000
