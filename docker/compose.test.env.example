# Only loaded explicitly by ./docker/test-compose.sh; never commit compose.test.env.
# Use the dedicated expiring camera-test device, never an official attendance token.
EOFFICE_BASE_URL=https://api-e-office.tabalongkab.go.id
# Required: private Tailscale IP of the TLS origin; keep the HTTPS hostname above.
EOFFICE_PRODUCTION_ORIGIN_IP=replace-with-private-tailscale-origin-ip
EOFFICE_DEVICE_TOKEN=replace-with-dedicated-expiring-test-device-token
EOFFICE_HOST_MODEL_DIR=/absolute/path/outside-project/eoffice-models
EOFFICE_HOST_KEY_FILE=/absolute/path/outside-project/eoffice-test-secrets/eoffice-key.json
CAMERA_HOST_PORT=5000
