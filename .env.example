# Salin file ini menjadi .env lalu isi nilainya.
# File .env TIDAK BOLEH dimasukkan ke Git.

# development | production | testing
APP_ENV=development

# Buat string acak dengan perintah:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-string-acak-hasil-perintah-di-atas

# Koneksi MySQL / MariaDB (XAMPP atau Laragon)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=absensi_wajah
DB_USER=absensi_app
DB_PASSWORD=ganti-dengan-password-user-database

# Zona waktu kantor (Tabalong, Kalimantan Selatan = WITA)
OFFICE_TIMEZONE=Asia/Makassar

# Lokasi file kunci enkripsi templat wajah.
# WAJIB di luar folder proyek agar tidak ikut ke Git atau tersalin bersama kode.
# Buat filenya dengan: flask --app app biometric-keygen
BIOMETRIC_KEY_FILE=D:\absensi-secrets\biometric_keys.json

# Kamera (Tahap 3). Lihat daftar kamera dengan: flask --app app camera-scan
# CAMERA_NAME memilih kamera berdasarkan nama (disarankan), CAMERA_INDEX
# hanya dipakai jika nama tidak dapat dibaca.
CAMERA_NAME=C270
CAMERA_INDEX=0
CAMERA_BACKEND=dshow
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30

# Model AI (Tahap 3B). Unduh dengan: flask --app app models-download
# MODEL_DIR boleh dikosongkan (bawaan: folder model_files di proyek).
FACE_DETECT_WIDTH=640
FACE_MIN_SCORE=0.85
FACE_MIN_SIZE=80
FACE_MIN_SHARPNESS=40

# Pencocokan dan pelacakan (Tahap 3C). Nilai SEMENTARA, kalibrasi di lokasi.
FACE_MATCH_THRESHOLD=0.60
FACE_MATCH_MARGIN=0.05
TRACK_WINDOW=5
TRACK_CONFIRM_VOTES=3
IDENTITY_COOLDOWN_SECONDS=30

# Aturan absensi (Tahap 4A)
# Check-in dibuka sekian menit sebelum jam masuk jadwal.
CHECKIN_EARLY_MINUTES=120
# Check-out baru diterima setelah sekian menit sejak check-in.
CHECKOUT_MIN_MINUTES=240
# Batas check-out setelah jam pulang jadwal (jam).
CHECKOUT_GRACE_HOURS=6
# true = jam pulang mengikuti lintasan terakhir; false = lintasan pertama.
CHECKOUT_UPDATE_LATER=true

# Kios (Tahap 4B). Boleh dikosongkan; bawaan di folder instance proyek.
# KIOSK_STATE_FILE=
# KIOSK_LOCK_FILE=
# Seberapa sering layanan kamera memuat ulang templat wajah (detik).
TEMPLATE_RELOAD_SECONDS=60

# Anti-foto (Tahap 4D). off | passive | challenge | passive+challenge
LIVENESS_MODE=passive+challenge
# Rata-rata peluang wajah asli: >= REAL lolos, <= SPOOF ditolak, di antaranya
# ragu (lalu diminta menoleh jika mode memakai challenge). Nilai SEMENTARA.
LIVENESS_REAL_THRESHOLD=0.7
LIVENESS_SPOOF_THRESHOLD=0.3
LIVENESS_MIN_SAMPLES=3
LIVENESS_DECIDE_SECONDS=3
LIVENESS_CHALLENGE_SECONDS=6
LIVENESS_CHALLENGE_DELTA=0.18
# true jika gambar kamera dicerminkan (arah kiri/kanan tantangan terbalik).
LIVENESS_MIRRORED=false

# Urutan pengaturan format kamera yang berhasil (lihat saran camera-check).
# Untuk C270 di komputer pengembang: format-dua-kali
CAMERA_FORMAT_STRATEGY=

# Backup (Tahap 5D). Sebaiknya di luar folder proyek.
BACKUP_DIR=D:\absensi-backup
BACKUP_KEEP=30

# API baca-saja (docs/API.md): batas permintaan per token per menit.
API_RATE_LIMIT=120

# Integrasi e-office: default standalone mempertahankan mode kios lama.
ATTENDANCE_MODE=standalone
# Saat eoffice: isi URL HTTPS dan token perangkat; jangan masukkan token ke Git.
EOFFICE_BASE_URL=
EOFFICE_DEVICE_TOKEN=
# Aset operator; hash/dimensi dan kebijakan lengkap diperiksa sebelum pengenalan.
EOFFICE_AURAFACE_PATH=
EOFFICE_PERIOCULAR_PATH=
# File keyring dengan format biometric-keygen, di luar proyek. Jangan diganti
# setelah instance/eoffice.sqlite3 dibuat; kunci salah memerlukan operator.
EOFFICE_KEY_FILE=
# Mode eoffice WAJIB LIVENESS_MODE=passive. Tidak memakai ambang SFace lokal.
